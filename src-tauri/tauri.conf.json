{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghost Transfert Apple",
  "version": "0.1.0",
  "identifier": "app.ghosttransfert.apple",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ghost Transfert Apple",
        "width": 1320,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "publisher": "Ghost Transfert",
    "shortDescription": "Migration et sauvegarde sécurisées Apple vers Apple",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources/**/*"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["French", "English"], "displayLanguageSelector": false }
    },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
